# Copiar como .env (o generar uno de desarrollo con: npm run env:dev -w backend)
NODE_ENV=development
PUERTO=4010
# Origen del frontend (se valida en peticiones que modifican datos)
ORIGEN_PERMITIDO=http://localhost:5180

# --- Identidad ---
# cidituc  -> valida el token con GET {CIDITUC_API_URL}/usuarios/authStatusIA (servidor a servidor)
# simulado -> personas ficticias para desarrollo y pruebas (prohibido en producción)
IDENTIDAD_MODO=simulado
CIDITUC_API_URL=
CIDITUC_LOGOUT_URL=https://ciudaddigital.smt.gob.ar/?logout=true
CIDITUC_TIMEOUT_MS=5000

# --- Sesión ---
SESION_MINUTOS_INACTIVIDAD=30
SESION_HORAS_MAXIMAS=8

# --- Base de datos ---
# better-sqlite3 (desarrollo local) | mysql2 (piloto/producción)
DB_CLIENTE=better-sqlite3
DB_ADMIN_ARCHIVO=datos/salud_admin.sqlite
DB_CLINICA_ARCHIVO=datos/salud_clinica.sqlite
# Para mysql2: dos esquemas y dos usuarios distintos
DB_ADMIN_HOST=
DB_ADMIN_PUERTO=3306
DB_ADMIN_USUARIO=
DB_ADMIN_CLAVE=
DB_ADMIN_NOMBRE=salud_admin
DB_CLINICA_HOST=
DB_CLINICA_PUERTO=3306
DB_CLINICA_USUARIO=
DB_CLINICA_CLAVE=
DB_CLINICA_NOMBRE=salud_clinica
DB_SSL=true

# --- Fuentes de datos de empleados (integración futura) ---
# Vacías = deshabilitadas; mientras tanto, Capital Humano importa el padrón por CSV.
# Contrato esperado: docs/03-integracion-fuentes.md
FUENTE_PORTAL_EMPLEADO_URL=
FUENTE_PORTAL_EMPLEADO_TOKEN=
FUENTE_CIDITUC_EMPLEADOS_URL=
FUENTE_CIDITUC_TOKEN=
FUENTE_TIMEOUT_MS=15000

# --- Documentos ---
# Carpeta privada donde se guardan los archivos cifrados (nunca dentro de una carpeta pública)
DOCUMENTOS_DIR=datos/documentos

# --- Recordatorios ---
# Días mínimos de anticipación para pedir reprogramar un control
REPROGRAMACION_DIAS_MINIMOS=2
# Canales externos: dejar en false hasta contar con el servicio y la política de consentimiento
CANAL_EMAIL_HABILITADO=false
CANAL_WHATSAPP_HABILITADO=false

# --- Cifrado de datos clínicos (AES-256-GCM) ---
# 32 bytes en base64. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO_CLINICA=
